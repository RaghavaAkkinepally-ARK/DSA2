public class UberSurgeSegmentTree {

    static double[] zones = new double[16];

    public static void main(String[] args) {

        for(int i=0;i<16;i++)
            zones[i]=1.0;

        update(3,9,0.5);
        update(7,14,0.3);

        System.out.println("Max Surge [0,15] = " + queryMax(0,15));

        update(2,6,0.7);

        System.out.println("Max Surge [4,10] = " + queryMax(4,10));

        System.out.println("=== Program Executed Successfully ===");
    }

    static void update(int l,int r,double val){
        for(int i=l;i<=r;i++)
            zones[i]+=val;
    }

    static double queryMax(int l,int r){
        double max=zones[l];
        for(int i=l;i<=r;i++)
            max=Math.max(max,zones[i]);
        return max;
    }
}
